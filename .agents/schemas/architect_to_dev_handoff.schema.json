{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchitectToDevHandoff",
  "description": "Standardized transition payload from Software Architect to Senior Android Developer",
  "type": "object",
  "required": [
    "handoff_id",
    "schema_version",
    "timestamp",
    "sender",
    "recipient",
    "feature_id",
    "po_handoff_ref",
    "adr_path",
    "component_spec_path",
    "remediation_cycle",
    "architecture_pattern",
    "module_targets",
    "component_contracts",
    "file_manifest_plan"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-ARCH-DEV-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "object",
      "required": ["role", "agent_id"],
      "properties": {
        "role": { "type": "string", "const": "Software Architect" },
        "agent_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "required": ["role", "agent_id"],
      "properties": {
        "role": { "type": "string", "const": "Senior Android Developer" },
        "agent_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3,}$"
    },
    "po_handoff_ref": {
      "type": "string",
      "pattern": "^HANDOFF-PO-ARCH-[A-Za-z0-9_-]+$"
    },
    "adr_path": {
      "type": "string",
      "pattern": "^.*\\.md$"
    },
    "component_spec_path": {
      "type": "string",
      "pattern": "^.*\\.md$"
    },
    "remediation_cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "architecture_pattern": {
      "type": "string",
      "enum": ["MVI", "MVVM_COMPOSE", "CLEAN_ARCHITECTURE"]
    },
    "module_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "component_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_name",
          "package_name",
          "layer",
          "state_models",
          "action_events",
          "exposed_flows"
        ],
        "properties": {
          "component_name": { "type": "string" },
          "package_name": { "type": "string" },
          "layer": {
            "type": "string",
            "enum": ["UI", "VIEWMODEL", "DOMAIN", "DATA"]
          },
          "state_models": {
            "type": "array",
            "items": { "type": "string" }
          },
          "action_events": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exposed_flows": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "file_manifest_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_path", "action", "purpose"],
        "properties": {
          "target_path": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["CREATE", "MODIFY", "DELETE"]
          },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["coordinate", "scope"],
        "properties": {
          "coordinate": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": [
              "implementation",
              "api",
              "testImplementation",
              "androidTestImplementation"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
