{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevToArchitectEscalation",
  "description": "Standardized technical escalation payload from Senior Android Developer to Software Architect when architectural contracts are broken, uncompilable, or deficient",
  "type": "object",
  "required": [
    "handoff_id",
    "schema_version",
    "timestamp",
    "sender",
    "recipient",
    "feature_id",
    "architect_handoff_ref",
    "escalation_report_path",
    "remediation_cycle",
    "escalation_category",
    "contract_violations",
    "compilation_diagnostics",
    "proposed_remediation",
    "blocks_implementation"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-DEV-ARCH-ESC-[A-Za-z0-9_-]+$"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "object",
      "required": ["role", "agent_id"],
      "properties": {
        "role": {
          "type": "string",
          "const": "Senior Android Developer"
        },
        "agent_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "required": ["role", "agent_id"],
      "properties": {
        "role": {
          "type": "string",
          "const": "Software Architect"
        },
        "agent_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3,}$"
    },
    "architect_handoff_ref": {
      "type": "string",
      "pattern": "^HANDOFF-ARCH-DEV-[A-Za-z0-9_-]+$"
    },
    "escalation_report_path": {
      "type": "string",
      "pattern": "^.*\\.md$"
    },
    "remediation_cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "escalation_category": {
      "type": "string",
      "enum": [
        "UNCOMPILABLE_INTERFACE",
        "DEPENDENCY_UNSATISFIED",
        "UDF_CONTRACT_VIOLATION",
        "CONCURRENCY_MODEL_CONFLICT",
        "SPECIFICATION_DEFICIT"
      ]
    },
    "contract_violations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target_artifact",
          "artifact_path",
          "symbol_or_signature",
          "violation_category",
          "violation_description",
          "reproduction_snippet"
        ],
        "properties": {
          "target_artifact": {
            "type": "string",
            "enum": ["COMPONENT_SPEC", "ADR", "BUILD_CONFIG"]
          },
          "artifact_path": {
            "type": "string"
          },
          "symbol_or_signature": {
            "type": "string"
          },
          "violation_category": {
            "type": "string",
            "enum": [
              "SYNTAX_OR_TYPE_ERROR",
              "MISSING_EVENT_OR_STATE",
              "DEPENDENCY_RESOLUTION_FAILURE",
              "UDF_OR_THREADING_VIOLATION",
              "MUTABILITY_LEAK"
            ]
          },
          "violation_description": {
            "type": "string",
            "minLength": 10
          },
          "reproduction_snippet": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "compilation_diagnostics": {
      "type": "object",
      "required": ["compiler_attempted", "error_count", "compiler_errors"],
      "properties": {
        "compiler_attempted": {
          "type": "boolean"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "primary_error_code": {
          "type": "string"
        },
        "compiler_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "proposed_remediation": {
      "type": "object",
      "required": [
        "summary",
        "suggested_contract_change",
        "requires_adr_revision",
        "requires_component_spec_revision"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "suggested_contract_change": {
          "type": "string"
        },
        "requires_adr_revision": {
          "type": "boolean"
        },
        "requires_component_spec_revision": {
          "type": "boolean"
        },
        "suggested_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["coordinate", "scope"],
            "properties": {
              "coordinate": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "implementation",
                  "api",
                  "testImplementation",
                  "androidTestImplementation"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "blocks_implementation": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
