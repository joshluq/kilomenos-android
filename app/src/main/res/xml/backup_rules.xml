<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude encrypted stores that lose their keys on uninstall -->
    <exclude domain="sharedpref" path="kmsafe_auth_store_Dev.xml"/>
    <exclude domain="sharedpref" path="kmsafe_secure_prefs_Dev.xml"/>
    <exclude domain="sharedpref" path="kmsafe_auth_store_Prod.xml"/>
    <exclude domain="sharedpref" path="kmsafe_secure_prefs_Prod.xml"/>
</full-backup-content>